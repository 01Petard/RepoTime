{
  "name": "repotime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "engines": { "node": ">=24.11.0 <25" },
  "scripts": {
    "dev": "nuxt dev",
    "sync": "tsx scripts/sync-github.ts",
    "generate": "pnpm sync && nuxt generate",
    "generate:snapshot": "nuxt generate",
    "build": "pnpm generate",
    "preview": "sirv .output/public --port 4173 --host --dev",
    "typecheck": "nuxt typecheck",
    "test": "nuxt prepare && vitest run",
    "test:e2e": "playwright test",
    "verify:output": "tsx scripts/verify-output.ts"
  },
  "dependencies": {
    "@nuxt/ui": "^4.0.0",
    "d3-scale": "^4.0.2",
    "d3-zoom": "^3.0.0",
    "d3-selection": "^3.0.0",
    "lucide-vue-next": "^0.468.0",
    "nuxt": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "vue": "^3.5.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.0",
    "@playwright/test": "^1.55.0",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-zoom": "^3.0.8",
    "@types/node": "^24.0.0",
    "sirv-cli": "^3.0.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "vue-tsc": "^3.0.0"
  }
}
